# react-calendar@4.8.0 declares a peerOptional on @types/react capped at v18,
# while this project is on React 19 / @types/react 19. It is a TYPES-ONLY,
# OPTIONAL peer — react-calendar works fine at runtime on React 19; only its
# declared range is stale upstream.
#
# Without this flag `npm install` fails outright with ERESOLVE. The committed
# lockfile was evidently produced with the flag passed manually, which meant
# installs worked or failed depending on how each person (and each CI/Render
# build) happened to invoke npm. Pinning it here makes local, CI and Render
# resolve identically.
#
# Revisit when react-calendar ships a release with React 19 in its peer range.
legacy-peer-deps=true
